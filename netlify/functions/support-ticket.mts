import { randomUUID } from 'node:crypto';
import { getStoreSafe, json } from './_shared.mts';
import { notifyAdmin } from './_notifications.mts';
const clean=(v:any,n:number)=>String(v||'').trim().slice(0,n);
export default async (req:Request)=>{if(req.method!=='POST')return json({error:'Method not allowed'},405);let b:any={};try{b=await req.json()}catch{return json({error:'Invalid request'},400)}const name=clean(b.name,120),phone=clean(b.phone,40),email=clean(b.email,160),category=clean(b.category,60),message=clean(b.message,1500);if(!name||!phone||!message)return json({error:'Name, phone and message are required'},400);const ticketId='SK-'+Date.now().toString(36).toUpperCase()+'-'+randomUUID().slice(0,4).toUpperCase();const now=new Date().toISOString();const ticket={id:ticketId,name,phone,email,category,message,status:'open',created_at:now,updated_at:now,last_active_at:now,customer_last_active_at:now,admin_last_active_at:null};try{const store=getStoreSafe();await store.setJSON(`support/${ticketId}`,ticket);const firstMessageId=`MSG-${randomUUID().slice(0,12)}`;await store.setJSON(`support-messages/${ticketId}/${firstMessageId}`,{id:firstMessageId,ticket_id:ticketId,sender:'Customer',text:message,created_at:now,delivery_status:'sent',delivered_at:null,read_at:null})}catch(e){console.error('Support ticket persistence failed',e);return json({error:'We could not save your support case right now. Please retry in a moment or contact SKDOT by phone/WhatsApp.'},503)}
await notifyAdmin('support_ticket',{ticket_id:ticketId,name,phone,email,category,message});
const apiKey=process.env.BREVO_API_KEY;const to=process.env.SUPPORT_EMAIL;const sender=process.env.BREVO_SENDER_EMAIL||to;if(apiKey&&to&&sender){try{await fetch('https://api.brevo.com/v3/smtp/email',{method:'POST',headers:{'api-key':apiKey,'Content-Type':'application/json'},body:JSON.stringify({sender:{email:sender,name:'SKDOT Customer Support'},to:[{email:to,name:'SKDOT Support'}],subject:`New SKDOT support request ${ticketId} — ${category}`,textContent:`Ticket: ${ticketId}\nName: ${name}\nPhone: ${phone}\nEmail: ${email}\nCategory: ${category}\n\n${message}`})})}catch{}}
return json({ok:true,ticket_id:ticketId});};
